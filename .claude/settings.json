{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2\u003e/dev/null || pwd)\"; /usr/bin/env python3 \"$ROOT/.claude/hooks/openspec_guard.py\"",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2\u003e/dev/null || pwd)\"; /usr/bin/env python3 \"$ROOT/.claude/hooks/openspec_context.py\"",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2\u003e/dev/null || pwd)\"; /usr/bin/env python3 \"$ROOT/.claude/hooks/openspec_stop.py\"",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2\u003e/dev/null || pwd)\"; /usr/bin/env python3 \"$ROOT/.claude/hooks/openspec_router.py\"",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}
